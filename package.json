{
  "name": "@ryze-digital/accordion",
  "description": "Enhances the <details> tag with animations and events ",
  "license": "MIT",
  "version": "1.1.0",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "index.js",
  "type": "module",
  "repository": "github:ryze-digital/accordion",
  "scripts": {
    "lint": "npm-run-all --parallel lint:*",
    "lint:scripts": "prettier src/scripts ./*.js --check && eslint src/scripts ./*.js",
    "lint:styles": "prettier src/styles/** ./*.scss --check && stylelint src/styles/** ./*.scss",
    "lint-fix": "npm-run-all --parallel lint-fix:* --continue-on-error",
    "lint-fix:scripts": "prettier src/scripts ./*.js --write && npm run lint:scripts -- --fix",
    "lint-fix:styles": "prettier src/styles/** ./*.scss --write && npm run lint:styles -- --fix",
    "build": "npm-run-all --parallel build:*",
    "build:scripts": "webpack",
    "build:styles": "npm run sass:build",
    "watch": "npm-run-all --parallel watch:*",
    "watch:scripts": "webpack --watch",
    "watch:styles": "npm run sass:watch",
    "sass:build": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules",
    "sass:watch": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules --watch",
    "prebuild": "node pre-build.js"
  },
  "dependencies": {
    "@ryze-digital/js-utilities": "^1.3.0",
    "@ryze-digital/scss-utilities": "^1.2.0"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@ryze-digital/stylelint-config-website": "^2.0.0",
    "npm-run-all2": "^9.0.4",
    "sass": "^1.108.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "keywords": [
    "javascript",
    "js",
    "accordion",
    "details"
  ],
  "peerDependencies": {
    "@ryze-digital/js-utilities": "^1.3.0",
    "@ryze-digital/scss-utilities": "^1.2.0"
  },
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  }
}
